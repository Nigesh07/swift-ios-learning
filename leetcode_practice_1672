class Solution {
    func maximumWealth(_ accounts: [[Int]]) -> Int {
        var ans=0
        for i in 0..<accounts.count{
            var sum=0;
            for j in 0..<accounts[0].count{
                sum=sum+accounts[i][j]
            }
           ans=max(sum,ans)
        }
        return ans
    }
}
